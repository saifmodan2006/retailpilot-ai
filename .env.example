# Copy to .env and replace these values. Do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# For host development with `docker compose up -d db`:
DATABASE_URL=postgresql+psycopg://retailpilot:replace-with-a-random-hex-password@127.0.0.1:5433/retailpilot
DEMO_ENABLED=true
# Public hosting MUST use a fresh dedicated database with these boundaries:
PUBLIC_DEMO=false
DEMO_TTL_HOURS=2
DEMO_MAX_TENANTS=4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ERP_URL=http://127.0.0.1:8001
ERP_TOKEN=local-simulator-only
# Disabled by default; only question + tool allowlist go to an optional provider.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Persistent identity pilot: OFF until provider + email + recovery checks pass.
ACCOUNTS_ENABLED=false
REGISTRATION_ENABLED=false
REGISTRATION_ALLOWLIST=
# Keep restricted until public email delivery / Google are configured and verified.
REGISTRATION_MODE=restricted
GOOGLE_AUTH_ENABLED=false
EMAIL_SIGNUP_ENABLED=true
EMAIL_DELIVERY_CONFIGURED=false
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate with cryptography.fernet.Fernet.generate_key(); store only as a secret.
SESSION_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:5173
ACCOUNT_COOKIE_SECURE=true
ACCOUNT_MAX_USERS=10
ACCOUNT_MAX_ORGANIZATIONS=4
REAL_UPLOADS_ENABLED=false
