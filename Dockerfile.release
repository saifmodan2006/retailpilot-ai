FROM node:24-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=10000
WORKDIR /app/backend
COPY backend/requirements.lock.txt .
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY backend/ ./
COPY sample_data/ /app/sample_data/
COPY --from=web /web/dist /app/frontend/dist
RUN useradd -m retailpilot && chown -R retailpilot:retailpilot /app
USER retailpilot
EXPOSE 10000
# One worker is required by the in-process limiter and workflow runner.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --limit-concurrency 12 --timeout-keep-alive 5 --no-proxy-headers"]
